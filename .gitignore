# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv*/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/
# notebooks/*.py (jupytext) is the source of truth and IS committed.
# colab/*.ipynb is generated and IS committed (students launch from it).

# ---------- Big data files (NOT for git, kept locally) ----------
# Each LoRA adapter here is ~130 MB; with chat_template + tokenizer the
# correct/ folder is ~150 MB. Four adapters = ~520 MB total. We never
# commit those weights — graders get them via the submission ZIP.
adapters/*/
!adapters/.gitkeep
# But keep the small config + README + chat_template files for reference:
!adapters/*/adapter_config.json
!adapters/*/README.md
!adapters/*/chat_template.jinja
# Tokenizer files inside correct/ (20 MB) — also ignored:
adapters/*/tokenizer.json
adapters/*/tokenizer_config.json
adapters/*/adapter_model.safetensors
adapters/*/adapter_model.bin
adapters/*/adapter_config.json

# ---------- Lab artefacts regenerated by notebooks ----------
data/split/
data/CUSTOM_DATASET.md
results/*.json
results/*.csv
!results/.gitkeep
gguf/
*.gguf
runs/
wandb/

# ---------- Model / HF / pip caches ----------
.cache/
hf_cache/
huggingface/
.cache/huggingface/
*.bin
*.safetensors
checkpoints/

# ---------- Secrets ----------
.env
.env.local
*.token
secrets.yaml

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---------- Build / distribution ----------
build/
dist/
*.egg-info/
*.whl